/* ✅ COMPACT WIDGET DESIGN - Complete CSS */

/* Modern spin animation for loading states */
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* ✅ COMPACT DESIGN - Updated Widget Container */
.chatbot-container {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
  display: flex !important;
  flex-direction: column !important;
  height: 100% !important;
  width: 100% !important;
  overflow: hidden !important;
  background: #ffffff !important;
  border-radius: 16px !important;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12) !important;
  border: 1px solid #e2e8f0 !important;
}

/* ✅ COMPACT HEADER - Further reduced for maximum message space */
.chatbot-container > div:first-child {
  flex-shrink: 0 !important;
  min-height: 50px !important; /* REDUCED */
  padding: 8px 16px !important; /* REDUCED */
  backdrop-filter: blur(8px) !important;
}

/* ✅ MAIN CHAT AREA - Maintains flexibility but optimizes space */
.chatbot-container > div:nth-child(2) {
  flex: 1 1 0% !important;
  min-height: 0 !important;
  display: flex !important;
  flex-direction: column !important;
  overflow: hidden !important;
}

/* ✅ EXPANDED MESSAGES CONTAINER - AVATAR SOLA YASLAMA */
.chatbot-container > div:nth-child(2) > div:first-child {
  flex: 1 1 0% !important;
  overflow-y: auto !important;
  padding: 12px 0px 12px 0px !important; /* Sol padding tamamen kaldırıldı: 4px → 0px */
  min-height: 0 !important;
  gap: 10px !important; /* REDUCED */
}

/* ✅ COMPACT INPUT AREA - This is the most critical change for your use case */
.chatbot-container > div:nth-child(2) > div:last-child {
  flex-shrink: 0 !important;
  padding: 16px 20px 12px 20px !important; /* Canvas: 16px 24px → Widget: 16px 20px 12px 20px */
  min-height: 48px !important; /* Canvas: 80px → Widget: 48px (40% reduction) */
  border-top: 1px solid rgba(0,0,0,0.06) !important;
  background: #ffffff !important;
  backdrop-filter: blur(8px) !important;
  box-shadow: 0 -8px 16px -8px rgba(0,0,0,0.04) !important;
}

/* ✅ COMPACT FOOTER - Reduced height for minimalist approach */
.chatbot-container > div:last-child {
  flex-shrink: 0 !important;
  background: #ffffff !important;
  backdrop-filter: blur(8px) !important;
  border-top: 1px solid rgba(0,0,0,0.06) !important;
  min-height: 40px !important; /* Canvas: 50px → Widget: 40px (20% reduction) */
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
  padding: 8px 20px !important; /* Canvas: 12px 24px → Widget: 8px 20px */
}

/* ✅ COMPACT CHAT INPUT STYLING - EN ÖNEMLİ KISIM */
.chatbot-input {
  border-radius: 12px !important;
  border: 2px solid #e5e7eb !important;
  transition: all 0.15s ease-in-out !important;
  font-family: 'Inter', sans-serif !important;
  min-height: 36px !important; /* YENİ: Compact height */
  padding: 6px 10px !important; /* YENİ: Compact padding */
}

.chatbot-input:focus-within {
  border-color: #3b82f6 !important;
  outline: none !important;
}

/* ✅ COMPACT TEXTAREA STYLING */
.chatbot-container textarea {
  min-height: 20px !important; /* YENİ: Canvas'tan daha küçük */
  max-height: 60px !important; /* YENİ: Canvas'tan daha küçük */
  padding: 6px 0 !important; /* YENİ: Compact padding */
