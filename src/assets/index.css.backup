  min-height: 20px !important;
  max-height: 60px !important;
  resize: none !important;
  box-sizing: border-box !important;
  font-family: 'Inter', sans-serif !important;
  line-height: 1.5 !important;
}

/* Force immediate button sizing */
button[title="Send Message"],
[class*="send"] button,
button:last-child {
  width: 28px !important;
  height: 28px !important;
  border-radius: 50% !important;
  flex-shrink: 0 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  border: none !important;
  cursor: pointer !important;
}

button[title="Send Message"] svg,
[class*="send"] button svg,
button:last-child svg {
  width: 12px !important;
  height: 12px !important;
}

/* === WIDGET ANA CONTAINER === */
.chatbot-container {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
  display: flex !important;
  flex-direction: column !important;
  height: 580px !important;
  width: 420px !important;
  min-width: 380px !important;
  max-width: 420px !important;
  min-height: 480px !important;
  overflow: hidden !important;
  background: #ffffff !important;
  border-radius: 20px !important;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12) !important;
  border: 1px solid #e2e8f0 !important;
  margin: 0 auto !important;
  position: relative !important;
  z-index: 1000 !important;
}

/* === HEADER === */
.chatbot-container > div:first-child {
  flex-shrink: 0 !important;
  min-height: 56px !important;
  padding: 12px 20px !important;
  display: flex !important;
  align-items: center !important;
  background: #fff !important;
  border-top-left-radius: 20px !important;
  border-top-right-radius: 20px !important;
  border-bottom: 1px solid #e5e7eb !important;
  z-index: 10 !important;
}

/* === CHAT AREA === */
.chatbot-container > div:nth-child(2) {
  flex: 1 1 0% !important;
  min-height: 0 !important;
  display: flex !important;
  flex-direction: column !important;
  overflow: hidden !important;
  background: #fff !important;
}

/* === MESAJLAR === */
.chatbot-container > div:nth-child(2) > div:first-child {
  flex: 1 1 0% !important;
  overflow-y: auto !important;
  padding: 16px 16px 16px 16px !important;
  min-height: 0 !important;
  gap: 12px !important;
  box-sizing: border-box !important;
}

/* === INPUT === */
.chatbot-container > div:nth-child(2) > div:last-child {
  flex-shrink: 0 !important;
  padding: 12px 16px 12px 16px !important;
  min-height: 56px !important;
  border-top: 1px solid #e5e7eb !important;
  background: #fff !important;
  box-shadow: 0 -8px 16px -8px rgba(0,0,0,0.04) !important;
  display: flex !important;
  align-items: center !important;
}

/* === BADGE/FOOTER === */
.chatbot-container > div:last-child {
  flex-shrink: 0 !important;
  background: #fff !important;
  border-top: 1px solid #e5e7eb !important;
  min-height: 40px !important;
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
  padding: 8px 16px !important;
}

/* === AVATAR & MESAJ === */
.chatbot-host-bubble, .guest-bubble {
  display: flex !important;
  align-items: flex-start !important;
  gap: 8px !important;
  margin-left: 0 !important;
  padding-left: 0 !important;
}
.avatar-wrapper, figure[data-testid="default-avatar"] {
  margin-left: 0 !important;
  margin-right: 8px !important;
  flex-shrink: 0 !important;
  width: 32px !important;
  height: 32px !important;
}

/* === HEADER BUTTONS === */
.widget-header-button, .widget-clear-chat-button, .widget-close-button, button[title="Close Chat"], button[title="Clear Chat"] {
  background: #fff !important;
  color: #374151 !important;
  border: 1px solid #d1d5db !important;
  width: 32px !important;
  height: 32px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  border-radius: 50% !important;
  cursor: pointer !important;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05) !important;
  z-index: 20 !important;
  margin-left: 8px !important;
}

.widget-header-button svg, .widget-clear-chat-button svg, .widget-close-button svg, button[title="Close Chat"] svg, button[title="Clear Chat"] svg {
  color: #000 !important;
  fill: #000 !important;
  stroke: #000 !important;
}

/* 🚀 CONTROLLED AVATAR LEFT ALIGNMENT - SOFTER OVERRIDE */
.host-container *,
[class*="host-container"] * {
  margin-left: 0px !important;
  padding-left: 0px !important;
}

/* Widget container should be visible */
.chatbot-container,
[class*="chatbot-container"] {
  display: flex !important;
  visibility: visible !important;
  opacity: 1 !important;
}

/* 🚀 EXTREME FLEX GAP ELIMINATION */
flowise-chatbot .flex,
.host-container.flex,
[class*="host-container"].flex,
div[class*="flex"][class*="justify-start"],
div[class*="flex"][class*="items-start"] {
  gap: 0px !important;
  column-gap: 0px !important;
  row-gap: 0px !important;
}

/* 🚀 AVATAR CONTAINER ULTRA POSITIONING */
.host-container > div:first-child {
  margin-left: 0px !important;
  padding-left: 0px !important;
  margin-right: 12px !important;
  flex-shrink: 0 !important;
  position: relative !important;
  left: 0px !important;
}

/* ✅ MAXIMUM SPECIFICITY WIDGET HEADER BUTTONS - Force override everything */
.widget-header-button.widget-clear-chat-button.rounded-full,
.widget-header-button.widget-close-button.rounded-full,
button.widget-header-button.widget-clear-chat-button,
button.widget-header-button.widget-close-button,
button[title="Close Chat"].widget-header-button.rounded-full,
button[title="Clear Chat"].widget-header-button.rounded-full,
/* ✅ ULTRA GÜÇLÜ WIDGET HEADER BUTTONS - Her durumda BEYAZ arka plan, SİYAH iconlar */
