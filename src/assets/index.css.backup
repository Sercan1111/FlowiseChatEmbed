/* ✅ REACH US BUTTON EXCEPTION - Keep API color - DO NOT OVERRIDE */
/* reach-us-button gets its background from inline styles in Bot.tsx */

/* ✅ FORCE WHITE BACKGROUND - All containers MUST be white */
flowise-chatbot,
.chatbot-container,
.input-container,
.chatbot-input,
flowise-chatbot > div,
flowise-chatbot div:not(.lite-badge):not([class*="badge"]):not(.reach-us-button):not(.chat-close-button):not(.w-full),
