/* ✅ AVATAR POSITIONING AND SIZE - Canvas uyumlu */
.host-container .flex.justify-center.items-center.rounded-full {
  margin-right: 8px !important;
  margin-top: 0px !important;
  width: 30px !important;
  height: 30px !important;
  flex-shrink: 0 !important;
}

/* ✅ AVATAR SIZE AND POSITIONING FIXES - Canvas uyumlu */
.host-container figure[data-testid="default-avatar"],
.host-container .avatar-wrapper {
  margin-right: 8px !important;
  margin-top: 0px !important;
  flex-shrink: 0 !important;
  width: 30px !important;
  height: 30px !important;
}

/* Desktop avatar size - Biraz daha büyük */
@media (min-width: 768px) {
  figure[data-testid="default-avatar"] {
    width: 44px !important; /* 40px → 44px */
    height: 44px !important; /* 40px → 44px */
    margin-right: 8px !important;
    margin-top: 0px !important;
    flex-shrink: 0 !important;
  }
  
  figure[data-testid="default-avatar"] img {
    width: 36px !important; /* 32px → 36px */
    height: 36px !important; /* 32px → 36px */
  }
}

/* Mobile avatar size - Canvas uyumlu */
@media (max-width: 767px) {
  figure[data-testid="default-avatar"] {
    width: 36px !important;
    height: 36px !important;
    margin-right: 8px !important;
    margin-top: 0px !important;
    flex-shrink: 0 !important;
  }
  
  figure[data-testid="default-avatar"] img {
    width: 28px !important;
    height: 28px !important;
  }
}

/* ✅ MESSAGE BUBBLE ALIGNMENT WITH AVATAR - Canvas uyumlu */
.host-container .chatbot-host-bubble {
  margin-left: 0 !important;
}

/* ✅ ULTIMATE LEFT ALIGNMENT FIX - NUCLEAR APPROACH */
/* Chat container - sol padding ve margin'i zorla 0 yap */
.flex-1.overflow-y-auto,
div[class*="flex-1"][class*="overflow-y-auto"] {
  padding-left: 8px !important;
  padding-right: 8px !important;
  box-sizing: border-box !important;
}

/* Host container - ABSOLUTE left alignment */
.host-container,
.flex.flex-row.justify-start.items-start.host-container,
div[class*="host-container"] {
  margin-left: 0 !important;
  padding-left: 0 !important;
  position: relative !important;
  left: 0 !important; /* Force to leftmost position */
}

/* Avatar container - NO left spacing */
.host-container > div:first-child,
.host-container [style*="margin-right"],
.host-container [style*="flex-shrink"] {
  margin-left: 0 !important;
  padding-left: 0 !important;
  position: relative !important;
  left: 0 !important; /* Force avatar to leftmost position */
}

/* ✅ ULTIMATE LEFT ALIGNMENT FIX - Tailwind override */
/* Tailwind Flexbox sınıflarını override et */
flowise-chatbot .flex.flex-row.justify-start,
flowise-chatbot .flex-1[style*="overflow"] {
  margin-left: 0 !important;
  padding-left: 0 !important;
}

/* Flowise chatbot container'ın kendisini de kontrol et */
flowise-chatbot [style*="flex: 1"] {
  margin-left: 0 !important;
  padding-left: 0 !important;
}

/* ✅ CRITICAL - Tailwind px-6 sınıfını tamamen override et */
/* px-6 = padding-left: 1.5rem (24px) - Bu sol gap'in ana kaynağı! */
/* ✅ UPDATED SELECTOR - px-6 kaldırıldı */
.flex-1.overflow-y-auto.py-6.space-y-4 {
  padding-left: 0 !important; /* Override px-6 (24px) */
  margin-left: 0 !important;
}

/* Alternative selector for safety */
flowise-chatbot [class*="px-6"] {
  padding-left: 0 !important;
}

/* ✅ ULTRA-AGGRESSIVE LEFT ALIGNMENT - Force everything flush left */
flowise-chatbot * {
  margin-left: 0 !important;
  padding-left: 0 !important;
}

/* ✅ SPECIFIC OVERRIDES FOR CHAT ELEMENTS */
flowise-chatbot .flex,
flowise-chatbot [class*="flex"],
flowise-chatbot .flex-1,
flowise-chatbot [class*="flex-1"],
flowise-chatbot .space-y-4,
flowise-chatbot [class*="space-y"],
flowise-chatbot .overflow-y-auto,
flowise-chatbot [class*="overflow"] {
  margin-left: 0 !important;
  padding-left: 0 !important;
}

/* ✅ BOT MESSAGE CONTAINER - Force flush left */
flowise-chatbot .flex.items-start.space-x-3,
flowise-chatbot [class*="items-start"],
flowise-chatbot [class*="space-x"] {
  margin-left: 0 !important;
  padding-left: 0 !important;
  justify-content: flex-start !important;
}

/* ✅ AVATAR CONTAINER - Absolute left alignment */
flowise-chatbot .flex-shrink-0,
flowise-chatbot [class*="flex-shrink"] {
  margin-left: 0 !important;
  padding-left: 0 !important;
}

/* ✅ EXCEPTION RULES - Restore padding for inputs/buttons where needed */
flowise-chatbot input,
flowise-chatbot textarea,
flowise-chatbot button,
flowise-chatbot select {
  padding-left: 12px !important;
}

/* ✅ FLASH PREVENTION - Critical CSS must be first */
/* This CSS must be parsed immediately to prevent input width flash */

/* ✅ CLEAN VERSION - Input styling - TAM GENİŞLİK - GÜNCELLENDİ */
flowise-chatbot input[placeholder*="Type your message"],
flowise-chatbot textarea[placeholder*="Type your message"],
input[placeholder*="Type your message"],
textarea[placeholder*="Type your message"] {
  /* Ana fix - boyut - TAM GENİŞLİK - GÜNCELLENDİ */
  width: calc(100% - 40px) !important; /* ✅ Daha az boşluk bırakıldı */
  min-width: 150px !important; /* ✅ Minimum genişlik daha da azaltıldı */
  flex: 1 1 0% !important;
  flex-grow: 1 !important;
  box-sizing: border-box !important;
  
  /* ✅ CLEAN STYLING */
  background: #ffffff !important;
  border: 1px solid #e5e7eb !important;
  border-radius: 8px !important;
  color: #111827 !important;
  font-weight: 400 !important;
}

/* ✅ YENİ - TextInput widget tam genişlik */
.text-input-widget,
.widget-textinput-container,
.widget-input-container {
  width: 100% !important;
  max-width: 100% !important;
  box-sizing: border-box !important;
}

/* ✅ CLEAN VERSION - Container styling - TAM GENİŞLİK */
flowise-chatbot .input-container,
.input-container,
div:has(> input[placeholder*="Type your message"]),
div:has(> textarea[placeholder*="Type your message"]) {
  /* Ana fix - layout - TAM GENİŞLİK */
  display: flex !important;
  align-items: center !important;
  gap: 8px !important;
  width: 100% !important;
  max-width: 100% !important; /* ✅ TAM GENİŞLİK için max-width kaldırıldı */
  box-sizing: border-box !important;
  margin: 0 !important;
  padding: 0 !important; /* ✅ Container padding kaldırıldı, input kendi padding'i kullanacak */
  
  /* ✅ CLEAN STYLING */
  background: #ffffff !important;
  border: none !important; /* ✅ Container border kaldırıldı */
  border-radius: 0 !important; /* ✅ Container border-radius kaldırıldı */
}

/* ✅ CLEAN VERSION - Widget container */
flowise-chatbot {
  background: #ffffff !important;
  border-radius: 20px !important;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25) !important;
}

/* ✅ BURADAN SONRA ESKİ CSS'LERİNİZ DEVAM EDECEK... */
:host {
  display: block !important;
  width: 100% !important;
  height: 100% !important;
}

/* ULTRA PRIORITY: Input width fix - Applied IMMEDIATELY */
flowise-chatbot input[placeholder*="Type your message"],
